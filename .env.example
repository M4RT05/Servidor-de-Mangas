# ══════════════════════════════════════════════════════════════════════
#  SERVIDOR DE MANGAS — Variables de entorno
#  Copia este archivo como .env y rellena los valores reales.
#  NUNCA subas .env a GitHub — está en .gitignore.
# ══════════════════════════════════════════════════════════════════════


# ── AUTENTICACIÓN ──────────────────────────────────────────────────────────────

# Clave secreta para firmar los tokens JWT.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si no se define, el servidor genera una aleatoria en cada arranque
# (lo que invalida todas las sesiones activas al reiniciar).
JWT_SECRET=pon_aqui_una_clave_larga_y_aleatoria

# Credenciales del administrador principal.
# Si no se definen, el servidor usa "admin" / "admin" como fallback (inseguro).
ADMIN_USERNAME=tu_usuario_admin
ADMIN_PASSWORD=tu_contraseña_admin


# ── SERVIDOR ───────────────────────────────────────────────────────────────────

# Puerto en el que escucha el servidor. Default: 3000.
PORT=3000


# ── RUTAS DE MANGAS (servidor) ─────────────────────────────────────────────────

# Carpeta principal de mangas que sirve el servidor.
# Puede ser ruta absoluta (recomendado en Windows) o relativa al proyecto.
# Default si no se define: ./main
MANGA_PATH=C:\ruta\a\tu\carpeta\de\mangas

# Carpetas adicionales de mangas (opcional).
# El servidor las fusiona y sirve todo junto.
# Agrega MANGA_PATH_3, MANGA_PATH_4, etc. si necesitas más.
# MANGA_PATH_2=D:\otra\carpeta\de\mangas


# ── RUTA DE MANGAS (scraper) ───────────────────────────────────────────────────

# Carpeta donde el scraper descarga los capítulos.
# Si no se define, el scraper usa MANGA_PATH como fallback.
# Útil si el scraper descarga a una ubicación distinta de la que sirve el servidor.
MANGA_PATH_SCRAPER=C:\ruta\a\tu\carpeta\de\mangas
