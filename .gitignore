# ── DEPENDENCIAS ──────────────────────────────────────────────────────────────
node_modules/
package-lock.json

# ── VARIABLES DE ENTORNO (contraseña y JWT — NUNCA subir) ─────────────────────
.env

# ── DATOS DE USUARIOS (información personal y hashes de contraseña) ───────────
server/data/users.json
server/data/avatars/

# ── DATOS DE LECTURA (progreso e historial personal) ─────────────────────────
server/progress.json
server/detected_dates.json
# entradas de progreso huérfanas (mangas borrados/renombrados) generadas por manga.js
server/progress_orphans.json

# ── BACKUPS AUTOMÁTICOS (contienen copias de progress.json, etc.) ────────────
server/backups/

# ── SCRAPER — datos de seguimiento y archivos runtime ─────────────────────────
# seguimiento.json tiene URLs y slugs de tu colección personal; usa seguimiento.example.json como plantilla
scraper/seguimiento.json
# estado runtime de rotación de dominios de Ikigai
scraper/ikigai_estado.json
# reporte HTML generado automáticamente con historial de escaneos embebido
scraper/reporte.html
# lock de PID: se crea al ejecutar el scraper y se borra al terminar
scraper/scraper.lock
# estado runtime en vivo (PID, heartbeat, progreso del ciclo actual) — lo
# reescribe el scraper en cada corrida, no aporta nada versionado
scraper/estado_vivo.json
# backups de seguimiento que el scraper puede crear (ej. seguimiento.json.bak)
scraper/seguimiento.json.bak
# dump de HTML crudo que Selenium guarda para depurar bloqueos/CAPTCHAs
scraper/debug_selenium.html

# ── CACHÉ / ÍNDICES GENERADOS (regenerables, no versionar) ────────────────────
# snapshot completo de tu librería (catalogIndex.js lo reconstruye solo)
server/catalog_index.json
# caché de miniaturas en disco (thumbnails.js) — binarios pesados y regenerables
server/data/thumb_cache/

# ── CARPETA DE MANGAS (archivos pesados) ──────────────────────────────────────
main/

# ── SISTEMA OPERATIVO ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── LOGS ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
